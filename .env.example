# Konfigurasi server
PORT=3000
NODE_ENV=development

# --- Database PostgreSQL (Aiven) --------------------------------------------
DB_HOST=pg-11aef27b-falen.b.aivencloud.com
DB_PORT=11348
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=
DB_SSL=true
# Optional: path to the Aiven CA certificate (ca.pem) for full TLS verification.
# DB_SSL_CA=./certs/aiven-ca.pem

# --- Autentikasi (JWT) ------------------------------------------------------
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=1d

# --- CORS -------------------------------------------------------------------
# Daftar origin frontend yang diizinkan, dipisah tanda koma.
# Gunakan '*' saat masih development, lalu isi domain Vercel/Netlify saat deploy.
# CORS_ORIGINS=https://spoth-umkm.vercel.app,http://localhost:5000

# --- Penyimpanan foto --------------------------------------------------------
# Folder (relatif terhadap root project) untuk menyimpan foto tempat.
# UPLOAD_DIR=uploads
