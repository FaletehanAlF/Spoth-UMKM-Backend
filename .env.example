# Konfigurasi server
PORT=3000
NODE_ENV=development

# --- Reverse proxy / load balancer -------------------------------------------
# Jumlah hop proxy tepercaya untuk header X-Forwarded-For, dipakai oleh
# rate limiter agar tidak salah membaca IP client.
#   - Server langsung terbuka (tanpa proxy)  -> biarkan kosong / 0
#   - 1 reverse proxy (Nginx, Render, Railway) -> 1
#   - Cloudflare + Nginx                     -> 2
# JANGAN gunakan nilai "true": header bisa dipalsukan untuk melewati rate limit.
# TRUST_PROXY=1

# --- Database PostgreSQL (Aiven) --------------------------------------------
# Ganti dengan kredensial milik Anda. Jangan commit nilai asli ke Git.
DB_HOST=your-database-host.example.com
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=
DB_SSL=true
# Path ke sertifikat CA Aiven (ca.pem). WAJIB di production saat DB_SSL=true.
# Contoh: DB_SSL_CA=./certs/aiven-ca.pem
# DB_SSL_CA=
#
# Catatan: user database runtime sebaiknya bukan user admin. Gunakan user
# dengan hak DML (SELECT/INSERT/UPDATE/DELETE) saja, bukan DDL.

# --- Autentikasi (JWT) ------------------------------------------------------
# Gunakan string acak panjang (minimal 32 karakter di production).
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=1d

# --- CORS -------------------------------------------------------------------
# Daftar origin frontend yang diizinkan, dipisah tanda koma.
# Di production nilai ini WAJIB diisi (server menolak start jika kosong/"*").
# Di development, jika kosong semua origin diizinkan dan localhost port apa pun.
# CORS_ORIGINS=https://spoth-umkm.vercel.app,http://localhost:5000

# --- Penyimpanan foto --------------------------------------------------------
# Folder (relatif terhadap root project) untuk menyimpan foto tempat.
# UPLOAD_DIR=uploads

# --- Cloudinary --------------------------------------------------------------
# Penyimpanan gambar di cloud. Folder utama: spoth-umkm (lihat CLOUDINARY_FOLDER).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=spoth-umkm

# --- Midtrans (pembayaran) ---------------------------------------------------
# Ambil dari dashboard Midtrans: Settings > Access Keys.
# PENTING: pilih environment di dropdown kiri atas SEBELUM membuka Access Keys.
#   - Sandbox    -> https://dashboard.sandbox.midtrans.com/settings/access_keys
#   - Production -> https://dashboard.midtrans.com/settings/access_keys
# Pastikan URL dashboard benar; key sandbox dan production berbeda.
#   - Sandbox    -> transaksi uji coba (tidak memotong uang asli).
#   - Production -> transaksi uang asli.
# Pembayaran memakai halaman Snap (redirect_url), jadi cukup Server Key.
# Server Key cukup punya izin "Snap Checkout: Write". Izin yang sama juga
# dipakai untuk membaca status transaksi, jadi "Core API: Read" tidak wajib.
# Sejak Oktober 2026 Server Key hanya ditampilkan sekali saat dibuat; simpan
# nilainya baik-baik. Kalau hilang, buat key baru lalu revoke yang lama.
# Server key = rahasia, hanya dipakai backend.
MIDTRANS_SERVER_KEY=
# Sejak 28 Oktober 2026, verifikasi webhook memakai Signature Secret Key.
# Ambil dari Settings > Access Keys > Signature Secret Key.
# Kosongkan jika akun Anda masih memakai Server Key lama untuk signature.
MIDTRANS_SIGNATURE_SECRET_KEY=
# true = transaksi uang asli. Biarkan false untuk sandbox.
MIDTRANS_IS_PRODUCTION=false
